# --- Base de datos (Neon Postgres) ---
# Crea un proyecto en https://neon.tech, copia la connection string con pooler.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/tronito?sslmode=require"

# --- MercadoPago ---
# "sandbox" (default) usa credenciales de prueba; "production" usa las reales.
MP_ENV="sandbox"
# Access Token del modo activo (sandbox o producción, según MP_ENV).
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxx"
# Secreto de firma del webhook (Tus integraciones > la app > Webhooks > Firma secreta).
MP_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"

# --- Sitio ---
# URL pública completa (sin slash final), usada en back_urls y notification_url.
# En local con MercadoPago necesitas un túnel público (ver README) porque el
# webhook no puede llegar a localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Panel de admin ---
ADMIN_USER="admin"
ADMIN_PASSWORD="cambia-esto"
